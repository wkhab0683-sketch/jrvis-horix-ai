{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile document",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email"]
    },
    "UserSchedule": {
      "title": "UserSchedule",
      "description": "Schedule item associated with an authenticated user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "time": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "isCompleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "time", "date"]
    },
    "AiCreation": {
      "title": "AiCreation",
      "description": "Generative AI media generated by user: music, image, video, transcription",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["MUSIC", "IMAGE", "VIDEO", "TRANSCRIPTION"] },
        "model": { "type": "string" },
        "prompt": { "type": "string" },
        "outputData": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "model", "prompt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Multi-turn Gemini chat message history item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "modelUsed": { "type": "string" },
        "groundingType": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "role", "text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile document"
    },
    "/users/{userId}/schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/UserSchedule" },
      "description": "User persistent schedule items"
    },
    "/users/{userId}/creations/{creationId}": {
      "schema": { "$ref": "#/entities/AiCreation" },
      "description": "User generative creations (music, image, video, transcripts)"
    },
    "/users/{userId}/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "User multi-turn chat history messages"
    }
  }
}
