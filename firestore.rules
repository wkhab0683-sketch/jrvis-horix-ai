rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId);

      // User schedules subcollection
      match /schedules/{scheduleId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0;
        allow delete: if isOwner(userId);
      }

      // User generative AI creations (music, images, videos, audio transcripts)
      match /creations/{creationId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.type in ['MUSIC', 'IMAGE', 'VIDEO', 'TRANSCRIPTION']
          && request.resource.data.prompt is string;
        allow delete: if isOwner(userId);
      }

      // User chat messages
      match /chat_messages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.userId == userId
          && request.resource.data.role in ['user', 'model']
          && request.resource.data.text is string;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
